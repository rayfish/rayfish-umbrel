# Dev variant of Dockerfile: packages a prebuilt linux ray binary from the
# build context (e.g. `just cross` output copied to ./ray) instead of
# compiling from source. Used for local installs while iterating.
FROM debian:bookworm-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates iproute2 python3 \
    && rm -rf /var/lib/apt/lists/*
COPY ray /usr/local/bin/ray
COPY rayfish-vpn/icon.png /usr/local/lib/rayfish/icon.png
COPY docker/gui-proxy.py /usr/local/lib/rayfish/gui-proxy.py
COPY docker/start.sh /usr/local/bin/rayfish-start
RUN chmod +x /usr/local/bin/rayfish-start /usr/local/bin/ray
CMD ["rayfish-start"]
